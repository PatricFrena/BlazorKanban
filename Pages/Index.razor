@page "/"
@rendermode InteractiveServe
@inject NavigationManager Navigation // Injetar o serviço de navegação

<h3>Bem-vindo ao Blazor Kanban!</h3>

<div class="d-flex flex-column align-items-center">

    <a href="/task-register" class="btn btn-outline-secondary" role="button">
        <i class="oi oi-list"></i> &nbsp; ➕ Cadastrar Nova Tarefa
    </a>

    <br/>
    <br />

    <a href="/kanban" class="btn btn-outline-secondary" role="button">
        <i class="oi oi-list"></i> &nbsp; Ver o Quadro Kanban Completo
    </a>

</div>

@code {
    private void NavigateToTaskForm()
    {
        // Redireciona o usuário para a nova rota
        Navigation.NavigateTo("/task-register");
    }
}