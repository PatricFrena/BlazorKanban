@page "/task-register"
@using BlazorKanban.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Cadastrar Task</PageTitle>

<style>
    :root {
        --bg: #f4f6f9;
        --card: #ffffff;
        --text: #222;
        --muted: #666;
        --primary: #1e88e5;
        --border: #e8e8e8;
        --radius: 14px;
        --shadow: 0 2px 10px rgba(0,0,0,.08);
    }

    /* Layout base */
    html, body { height: 100%; }
    body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        display: grid;
        place-items: center;
        padding: 16px;
    }

    /* Card central */
    .container {
        width: 100%;
        max-width: 720px;
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        padding: 18px;
    }

    .title {
        text-align: center;
        font-weight: 700;
        margin: 6px 0 12px;
    }

    /* Campo de entrada (visual estilo Bipagem) */
    .field { position: relative; }

    .input-like,
    .textarea-like,
    .select-like {
        width: 100%;
        box-sizing: border-box;
        font-size: 16px; /* evita zoom no iOS */
        padding: 10px 12px;
        border: 2px solid var(--border);
        border-radius: 8px;
        outline: none;
        transition: border-color .15s ease;
        background: #fff;
    }
    .input-like:focus,
    .textarea-like:focus,
    .select-like:focus {
        border-color: var(--primary);
    }

    .mb-3 { margin-bottom: 12px; }

    .validation {
        color: #d93025;
        font-size: 12px;
        margin-top: 6px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 0;
        padding: 10px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-secondary { background: #e4e6eb; color: #111; }

    .actions {
        display: flex;
        justify-content: space-between;
        margin-top: 16px;
    }

    @@media (max-width: 480px) {
        .container { padding: 14px; border-radius: 12px; }
        .title { font-size: 16px; }}
        
</style>

<div class="container">
    <h3 class="title">Cadastrar Nova Tarefa</h3>
    <hr />

    <div class="field">
        <EditForm Model="@newTask" OnValidSubmit="HandleSubmit" FormName="taskForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="field">
                <div class="mb-3">
                    <label for="title">Título</label>
                    <InputText id="title"
                               class="input-like"
                               @bind-Value="newTask.Title"
                               @bind-Value:event="oninput"
                               placeholder="Ex: Adicionar feature X" />
                    <ValidationMessage For="@(() => newTask.Title)">
                        <div class="validation">@context</div>
                    </ValidationMessage>
                </div>

                <div class="mb-3">
                    <label for="description">Descrição</label>
                    <InputTextArea id="description"
                                   class="textarea-like"
                                   @bind-Value="newTask.Description"
                                   @bind-Value:event="oninput"
                                   rows="4"
                                   placeholder="Detalhes da tarefa..." />
                    <ValidationMessage For="@(() => newTask.Description)">
                        <div class="validation">@context</div>
                    </ValidationMessage>
                </div>

                <div class="mb-3">
                    <label for="status">Status</label>
                    <InputSelect id="status"
                                 class="select-like"
                                 TValue="int"
                                 @bind-Value="newTask.KanbanListId"
                                 @bind-Value:event="onchange">
                        <option value="0">Selecione uma Opção...</option>
                        <option value="1">Iniciada</option>
                        <option value="2">Em Andamento</option>
                        <option value="3">Concluída</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => newTask.KanbanListId)">
                        <div class="validation">@context</div>
                    </ValidationMessage>
                </div>
            </div>

            <div class="actions">
                <button type="submit" class="btn btn-primary">
                    <span>Salvar</span>
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick='@(() => Navigation.NavigateTo("/kanban"))'>
                    <span>Cancelar</span>
                </button>
            </div>
        </EditForm>

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
                <div class="validation" style="margin-top:12px">@((MarkupString)feedbackMessage)</div>
        }
    </div>
</div>

@code {
    private List<KanbanList>? columns; // (opcional) caso vá popular o select pela API
    private TaskItem newTask = new()
        {
            Title = string.Empty,
            Description = string.Empty,
            CreatedAt = DateTime.Now // considere usar no servidor / ou DateTime.UtcNow
            
        };
    private string feedbackMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var uriCompleta = Navigation.ToAbsoluteUri("api/KanbanList");
            columns = await Http.GetFromJsonAsync<List<KanbanList>>(uriCompleta.ToString());
            // Se quiser popular o select dinamicamente, troque as <option> por um foreach em columns.
        }
        catch
        {
            feedbackMessage = "Erro ao carregar listas Kanban. Verifique se o backend está rodando.";
            columns = new List<KanbanList>();
        }
    }

    private async Task HandleSubmit()
    {
        // validação mínima do select
        if (newTask.KanbanListId == 0)
        {
            feedbackMessage = "Por favor, selecione um Status válido.";
            return;
        }

        var uriCompleta = Navigation.ToAbsoluteUri("api/TaskItem");
        var response = await Http.PostAsJsonAsync(uriCompleta.ToString(), newTask);

        if (response.IsSuccessStatusCode)
        {
            feedbackMessage = "Tarefa cadastrada com sucesso! Redirecionando...";
            await Task.Delay(1200);
            Navigation.NavigateTo("/kanban");
        }
        else
        {
            var content = await response.Content.ReadAsStringAsync();
            feedbackMessage = $"Erro ao salvar: {response.StatusCode}. Detalhes: {content}";
        }
    }
}