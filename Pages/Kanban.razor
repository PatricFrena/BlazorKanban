@page "/kanban"
@using BlazorKanban.Models
@inject HttpClient Http
@inject NavigationManager Navigation // Injete aqui

<h3 class="text-center my-4">Quadro Kanban</h3>

<div class="kanban-board">
    @if (columns == null)
    {
        <p>Carregando...</p>
    }
    else
    {
        @foreach (var column in columns)
        {
            <div class="kanban-column">
                <h4>@column.Title</h4>
                <div class="kanban-tasks">
                    @foreach (var task in column.Tasks)
                    {
                        <div class="kanban-task">
                            <p>@task.Title</p>
                            <small>@task.Description</small>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private List<KanbanList>? columns;

    protected override async Task OnInitializedAsync()
    {
        //columns = await Http.GetFromJsonAsync<List<KanbanList>>("api/KanbanList");

        // 1. Usa o NavigationManager para converter o caminho relativo em um URI absoluto
        var uriCompleta = Navigation.ToAbsoluteUri("api/KanbanList");

        // 2. Passa a URI completa para o GetFromJsonAsync
        // (O método ToString() é necessário para que o GetFromJsonAsync o receba como string)
        columns = await Http.GetFromJsonAsync<List<KanbanList>>(uriCompleta.ToString());

    }
}
